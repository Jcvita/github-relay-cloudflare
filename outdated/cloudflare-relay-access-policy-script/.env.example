CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

CLOUDFLARE_GITEA_IP_LIST_ID=your_gitea_ip_list_id_here
# Optional for searching IP lists by name
CLOUDFLARE_GITEA_IP_LIST_NAME=your_gitea_ip_list_name_here
CLOUDFLARE_GITHUB_IP_LIST_ID=your_github_ip_list_id_here
# Optional for searching IP lists by name
CLOUDFLARE_GITHUB_IP_LIST_NAME=your_github_ip_list_name_here

CLOUDFLARE_GITHUB_AC_POLICY_ID=
CLOUDFLARE_GITHUB_AC_POLICY_NAME=GitHub Git Hook IP Policy
CLOUDFLARE_GITEA_AC_POLICY_ID=
CLOUDFLARE_GITEA_AC_POLICY_NAME=Gitea WebSocket IP Policy

# Optional IDs. If unset, each application is found by its domain and path or created.
CLOUDFLARE_GITHUB_ACCESS_APPLICATION_ID=
CLOUDFLARE_GITEA_ACCESS_APPLICATION_ID=
CLOUDFLARE_GITHUB_ACCESS_APPLICATION_NAME=GitHub Git Hook
CLOUDFLARE_GITEA_ACCESS_APPLICATION_NAME=Gitea WebSocket

# Required hostname only: do not include a scheme, port, or path.
CLOUDFLARE_ACCESS_APPLICATION_DOMAIN=your-worker.example.com
# Exact route paths handled by the relay Worker.
CLOUDFLARE_GITHUB_ACCESS_APPLICATION_PATH=/webhooks/github/push
CLOUDFLARE_GITEA_ACCESS_APPLICATION_PATH=/relay/ws

GITEA_SERVER_PUBLIC_IPS=your_comma_separated_gitea_server_public_ips_and_blocks_here