# Terraform and Wrangler use this token directly; it is never a Terraform variable.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# custom_domain (recommended) or workers_dev; inferred from hostname if omitted.
RELAY_ENDPOINT_MODE=custom_domain
CLOUDFLARE_WORKER_NAME=githook-relay-worker
CLOUDFLARE_ACCESS_APPLICATION_DOMAIN=relay.example.com
# Required for custom_domain only. Zone must be in CLOUDFLARE_ACCOUNT_ID.
CLOUDFLARE_ZONE_ID=

# For workers_dev instead, use:
# RELAY_ENDPOINT_MODE=workers_dev
# CLOUDFLARE_ACCESS_APPLICATION_DOMAIN=githook-relay-worker.your-account-subdomain.workers.dev

GITEA_SERVER_PUBLIC_IPS=203.0.113.10,2001:db8::/48
# Required for deploy only. Use separate high-entropy values.
GITHUB_WEBHOOK_SECRET=
GITHUB_RELAY_WEBSOCKET_SECRET=

# Zero Trust list names retain the script-compatible naming convention: [a-z0-9_]+.
# Legacy CLOUDFLARE_{GITHUB,GITEA}_IP_LIST_ID settings are no longer used.
# Rules custom lists are left untouched, not created or synchronized.
CLOUDFLARE_GITHUB_IP_LIST_NAME=github_hooks_ips
CLOUDFLARE_GITHUB_IP_LIST_DESCRIPTION=List of GitHub IPs
CLOUDFLARE_GITEA_IP_LIST_NAME=gitea_server_ips
CLOUDFLARE_GITEA_IP_LIST_DESCRIPTION=List of Gitea IPs

# Optional Zero Trust list adoption IDs; otherwise discovered by name.
CLOUDFLARE_GITHUB_ZERO_TRUST_IP_LIST_ID=
CLOUDFLARE_GITEA_ZERO_TRUST_IP_LIST_ID=

CLOUDFLARE_GITHUB_AC_POLICY_ID=
CLOUDFLARE_GITHUB_AC_POLICY_NAME=GitHub Git Hook IP Policy
CLOUDFLARE_GITEA_AC_POLICY_ID=
CLOUDFLARE_GITEA_AC_POLICY_NAME=Gitea WebSocket IP Policy

CLOUDFLARE_GITHUB_ACCESS_APPLICATION_ID=
CLOUDFLARE_GITHUB_ACCESS_APPLICATION_NAME=GitHub Git Hook
CLOUDFLARE_GITEA_ACCESS_APPLICATION_ID=
CLOUDFLARE_GITEA_ACCESS_APPLICATION_NAME=Gitea WebSocket

# These values set BOTH the Rust Worker runtime routes and Access destinations.
# Defaults come from the source wrangler.toml [vars] when omitted.
# Use distinct, non-nested paths with ASCII URL-unreserved segments.
# No root path, trailing slash, empty/dot segments, percent encoding, query or fragment.
CLOUDFLARE_GITHUB_ACCESS_APPLICATION_PATH=/relay/webhooks/github/push
CLOUDFLARE_GITEA_ACCESS_APPLICATION_PATH=/relay/ws

# Optional source directory, resolved relative to this project, or an absolute path.
# WORKER_PROJECT_DIR=..\githook-relay-worker
# Optional full executable path if Terraform is not on PATH (include terraform.exe, not just its directory).
# TERRAFORM_BIN=C:\tools\terraform.exe
